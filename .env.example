# Database connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5440/thanhvinh


# Used to encrypt JWT tokens
PAYLOAD_SECRET=change-me

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=change-me

# Used to validate preview requests
PREVIEW_SECRET=change-me

# SMTP gửi email yêu cầu báo giá (bỏ trống thì chỉ ghi log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Website Thành Vinh Metal
# Email nhận yêu cầu báo giá nếu chưa cấu hình trong admin
QUOTE_TO_EMAIL=
